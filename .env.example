# Optional settings for the unified application.
# Export these variables in your shell before running macaron-artifacts.
# Keep credentials out of Git; .env is ignored but is not loaded automatically.

# MACARON_PORT=43860
# MACARON_DATA_DIR=/path/to/session-data
# MACARON_CLAUDE_PATH=/path/to/claude
# MACARON_CODEX_PATH=/path/to/codex
# MACARON_OPENCODE_PATH=/path/to/opencode
# PI_CODING_AGENT_DIR=/path/to/pi-agent

# Claude Code uses its native authentication and environment.
# ANTHROPIC_BASE_URL=https://api.example.com/v1
# ANTHROPIC_AUTH_TOKEN=<token>
