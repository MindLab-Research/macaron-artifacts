{
  "name": "@macaron/artifacts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build && bun build src/server/index.ts --target=node --format=esm --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.96",
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@opencode-ai/sdk": "1.18.29",
    "@headlessui/react": "2.2.10",
    "@lobehub/icons-static-svg": "1.95.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/stream": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@streamdown/cjk": "1.0.3",
    "@unocss/core": "66.8.1",
    "@unocss/preset-wind4": "66.8.1",
    "ai": "7.0.93",
    "partial-json": "0.1.7",
    "partial-react": "0.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "scheduler": "0.27.0",
    "shiki": "4.4.3",
    "streamdown": "2.5.0",
    "toml-eslint-parser": "1.0.3",
    "unocss-preset-animations": "1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/scheduler": "0.26.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "9.2.3",
    "tsx": "4.21.0",
    "typescript": "~7.0.2",
    "unocss": "66.8.1",
    "vite": "8.2.2"
  }
}
